# ============================================================
#  TK Ceria di Vercel (container FrankenPHP)
#  Dibangun otomatis oleh Vercel setiap kali Anda git push.
#  Rahasia (APP_KEY, password database, kunci Supabase) TIDAK ada di sini:
#  semuanya diisi di Vercel → Settings → Environment Variables.
# ============================================================
FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_pgsql opcache \
    && { echo 'upload_max_filesize=6M'; echo 'post_max_size=40M'; echo 'memory_limit=256M'; echo 'expose_php=Off'; } > "$PHP_INI_DIR/conf.d/tk-ceria.ini"

WORKDIR /app

FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --optimize-autoloader --prefer-dist

COPY . .
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs storage/app/private storage/app/public bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan view:cache \
    && php artisan event:cache

FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

# Suara Bahasa Indonesia yang natural untuk Ruang Belajar anak (dibuat di server, HP tidak perlu diatur).
# sherpa-onnx (lisensi Apache-2.0) + model Piper id_ID-news_tts-medium, keduanya diunduh dari GitHub.
# Bila unduhan gagal, build TETAP berhasil dan halaman memakai suara browser (lihat app/Support/Suara.php).
ARG SHERPA_VERSI=v1.13.8
RUN ( apt-get update && apt-get install -y --no-install-recommends bzip2 && rm -rf /var/lib/apt/lists/* || echo "bzip2 gagal dipasang" ) \
    && mkdir -p /opt/suara /tmp/unduh \
    && ( curl -fsSL --retry 3 -o /tmp/unduh/sherpa.tar.bz2 https://github.com/k2-fsa/sherpa-onnx/releases/download/${SHERPA_VERSI}/sherpa-onnx-${SHERPA_VERSI}-linux-x64-shared.tar.bz2 \
         && curl -fsSL --retry 3 -o /tmp/unduh/model.tar.bz2 https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/vits-piper-id_ID-news_tts-medium.tar.bz2 \
         && tar -xjf /tmp/unduh/sherpa.tar.bz2 -C /tmp/unduh && tar -xjf /tmp/unduh/model.tar.bz2 -C /tmp/unduh \
         && mkdir -p /opt/suara/bin /opt/suara/lib /opt/suara/model \
         && cp /tmp/unduh/sherpa-onnx-${SHERPA_VERSI}-linux-x64-shared/bin/sherpa-onnx-offline-tts /opt/suara/bin/ \
         && cp -a /tmp/unduh/sherpa-onnx-${SHERPA_VERSI}-linux-x64-shared/lib/. /opt/suara/lib/ \
         && cp /tmp/unduh/vits-piper-id_ID-news_tts-medium/id_ID-news_tts-medium.onnx /opt/suara/model/model.onnx \
         && cp /tmp/unduh/vits-piper-id_ID-news_tts-medium/tokens.txt /opt/suara/model/ \
         && cp -a /tmp/unduh/vits-piper-id_ID-news_tts-medium/espeak-ng-data /opt/suara/model/ \
         && LD_LIBRARY_PATH=/opt/suara/lib /opt/suara/bin/sherpa-onnx-offline-tts --vits-model=/opt/suara/model/model.onnx \
              --vits-tokens=/opt/suara/model/tokens.txt --vits-data-dir=/opt/suara/model/espeak-ng-data --output-filename=/tmp/unduh/tes.wav "Halo" \
         && echo "Mesin suara siap" \
         || ( rm -rf /opt/suara/bin; echo "Mesin suara tidak terpasang: halaman memakai suara browser" ) ) \
    && rm -rf /tmp/unduh

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Nilai bawaan yang aman; bisa ditimpa dari Environment Variables Vercel
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    SESSION_DRIVER=database \
    CACHE_STORE=database \
    QUEUE_CONNECTION=sync \
    SUPABASE_STORAGE=true \
    TRUSTED_PROXIES=* \
    DB_CONNECTION=pgsql \
    DB_SSLMODE=require

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
