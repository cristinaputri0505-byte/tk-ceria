# ============================================================
#  Contoh .env untuk SERVER (salin menjadi .env di server, lalu isi)
#  Jangan pernah upload file .env asli ke GitHub.
# ============================================================
APP_NAME="TK Ceria"
APP_ENV=production
APP_KEY=                       # isi dengan: php artisan key:generate
APP_DEBUG=false                # WAJIB false di server
APP_URL=https://domain-sekolah-anda.sch.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database MySQL dari panel hosting
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database
DB_USERNAME=user_database
DB_PASSWORD=password_database_yang_kuat

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true     # aktifkan setelah HTTPS (gembok) berjalan
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
