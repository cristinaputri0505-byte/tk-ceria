# ============================================================
#  Daftar Environment Variables untuk produksi (Vercel + Supabase)
#  Isi nilainya di Vercel â†’ Settings â†’ Environment Variables.
#  File ini hanya contoh: JANGAN tulis nilai asli di sini, dan jangan upload .env asli ke GitHub.
#  Nilai bawaan yang aman (APP_ENV, LOG_CHANNEL, SESSION_DRIVER, dll.) sudah diatur di Dockerfile.vercel.
# ============================================================

# --- Aplikasi ---
APP_NAME="TK Ceria"
APP_KEY=                        # buat di laptop: php artisan key:generate --show
APP_URL=https://domain-sekolah-anda.sch.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

# --- Database PostgreSQL Supabase (salin dari tombol "Connect" di dashboard Supabase) ---
DB_HOST=
DB_PORT=
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
# DB_CONNECTION=pgsql dan DB_SSLMODE=require sudah diatur di Dockerfile.vercel

# --- Sesi login ---
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

# --- Supabase Storage (file upload) ---
SUPABASE_URL=                   # Project Settings -> API -> Project URL
SUPABASE_SECRET_KEY=            # Project Settings â†’ API Keys â†’ secret key (hanya di server)
SUPABASE_BUCKET_PRIVAT=tk-ceria-privat
SUPABASE_BUCKET_PUBLIK=tk-ceria-publik

# Periksa kesiapan setelah online (dari laptop yang terhubung ke database produksi):
#   php artisan tk:cek-produksi
